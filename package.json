{
  "name": "rocky",
  "version": "0.0.0",
  "private": true,
  "description": "Single-user local AI engineering partner",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:i18n": "node scripts/check-i18n.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:i18n && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.1",
    "@agentclientprotocol/sdk": "1.7.0",
    "@langchain/core": "1.2.14",
    "@langchain/langgraph": "1.4.19",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@langchain/langgraph-sdk": "1.12.1",
    "@langchain/openai": "1.6.2",
    "@pdf-lib/fontkit": "1.1.1",
    "@xmldom/xmldom": "0.9.12",
    "deepagents": "1.14.1",
    "docx": "9.8.1",
    "exceljs": "4.4.0",
    "jszip": "3.10.2",
    "langchain": "1.5.15",
    "langsmith": "0.9.0",
    "mammoth": "1.13.0",
    "markdown-it": "15.0.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.1.200",
    "pptx-automizer": "0.9.4",
    "pptxgenjs": "4.0.1",
    "unpdf": "1.8.1",
    "zod": "4.3.6"
