{
  "name": "rocky",
  "version": "0.1.0-dev.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "24.12.0",
    "npm": "11.6.4"
  },
  "packageManager": "npm@11.6.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json && vite build --config apps/web/vite.config.ts",
    "start": "node dist/apps/daemon/src/main.js",
    "check": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "test": "vitest run",
    "test:contract": "vitest run tests/contracts.test.ts",
    "test:network": "vitest run tests/network.test.ts && node --import ./scripts/network-audit.mjs --import tsx scripts/evaluate.ts",
    "test:learning": "node --import tsx scripts/evaluate.ts",
    "test:e2e": "playwright test",
    "setup:browser": "playwright install chromium",
    "test:no-python": "node scripts/no-python.mjs",
    "check:licenses": "node scripts/licenses.mjs",
    "lint": "eslint apps packages fixtures tests scripts *.ts",
    "format:check": "prettier --check apps packages fixtures tests scripts *.ts *.mjs *.json *.md docs .github",
    "doctor": "node scripts/doctor.mjs",
    "check:secrets": "node scripts/repo-guards.mjs",
    "check:repo-size": "node scripts/repo-guards.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.4",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.1",
    "@ag-ui/core": "1.0.1",
    "@copilotkit/react-core": "1.77.0",
    "@hono/node-server": "2.1.3",
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.10",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "@langchain/langgraph-sdk": "1.9.23",
    "@modelcontextprotocol/sdk": "1.32.0",
    "deepagents": "1.14.1",
    "hono": "4.13.12",
    "langchain": "1.5.10",
    "langsmith": "0.9.0",
    "promptfoo": "0.120.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.3.6"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.64.0"
  }
}
