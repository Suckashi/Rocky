{
  "name": "rocky",
  "description": "A local AI engineering partner with explicit approvals, inspectable work, and reviewed learning.",
  "keywords": [
    "ai",
    "agents",
    "local-first",
    "mcp",
    "deepagents",
    "typescript"
  ],
  "version": "0.1.0-dev.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Suckashi/Rocky.git"
  },
  "homepage": "https://github.com/Suckashi/Rocky#readme",
  "bugs": {
    "url": "https://github.com/Suckashi/Rocky/issues"
  },
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "apps/daemon/package.json",
    "apps/web/package.json",
    "packages/contracts/package.json",
    "packages/agent-runtime/package.json",
    "scripts/doctor.mjs",
    "scripts/setup.mjs",
    "README.md",
    "README.zh-TW.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "docs/README.md",
    "docs/ROADMAP.md",
    "docs/implementation/dependency-licenses.json",
    "docs/user-guide.zh-TW.md",
    "docs/user-guide.en.md",
    "docs/backup.md",
    "docs/attachments.md",
    "docs/browser.md",
    "docs/environments.md",
    "docs/routines.md",
    "docs/tracking.md",
    "docs/learning.md",
    "fixtures/eval/learning-suite.json",
    "package-lock.json"
  ],
  "engines": {
    "node": "24.12.0",
    "npm": "11.6.4"
  },
  "packageManager": "npm@11.6.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-runtime-assets.mjs && vite build --config apps/web/vite.config.ts",
    "start": "node dist/apps/daemon/src/main.js",
    "check": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "docs:status": "node scripts/sync-acceptance.mjs --write",
    "test": "vitest run",
    "test:contract": "vitest run tests/contracts.test.ts tests/projection.test.ts tests/http.test.ts",
    "test:recovery": "vitest run tests/persistence.test.ts tests/storage-faults.test.ts tests/worker-channel.test.ts tests/inbox.test.ts tests/operation-ledger.test.ts tests/backup.test.ts",
    "test:network": "vitest run tests/network.test.ts && node --import ./scripts/network-audit.mjs --import tsx scripts/evaluate.ts",
    "test:learning": "node --import tsx scripts/evaluate.ts",
    "test:e2e": "playwright test",
    "setup:browser": "node scripts/setup.mjs browser",
    "setup": "node scripts/setup.mjs",
    "test:no-python": "node scripts/no-python.mjs",
    "check:licenses": "node scripts/licenses.mjs",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "lint": "eslint apps packages fixtures tests scripts *.ts",
    "format:check": "prettier --check apps packages fixtures tests scripts *.ts *.mjs *.json *.md docs .github",
    "doctor": "node scripts/doctor.mjs",
    "backup": "node dist/scripts/data-command.js backup",
    "restore": "node dist/scripts/data-command.js restore",
    "backup:verify": "node dist/scripts/data-command.js verify",
    "check:secrets": "node scripts/repo-guards.mjs",
    "check:repo-size": "node scripts/repo-guards.mjs",
    "check:package": "node scripts/repo-guards.mjs --history --package"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.4",
    "node-forge": "1.4.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.1",
    "@ag-ui/core": "1.0.1",
    "@copilotkit/react-core": "1.77.0",
    "@hono/node-server": "2.1.3",
    "@langchain/core": "1.2.14",
    "@langchain/langgraph": "1.4.10",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "@langchain/langgraph-sdk": "1.9.23",
    "@modelcontextprotocol/sdk": "1.32.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "croner": "10.0.1",
    "deepagents": "1.14.1",
    "hono": "4.13.12",
    "jpeg-js": "0.4.4",
    "js-tiktoken": "1.0.21",
    "langchain": "1.5.10",
    "langsmith": "0.9.0",
    "lucide-react": "0.525.0",
    "parse5": "7.3.0",
    "playwright-core": "1.63.0",
    "pngjs": "7.0.0",
    "promptfoo": "0.123.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "undici": "7.30.0",
    "yaml": "2.9.1",
    "zod": "4.3.6"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.64.0",
    "promptfoo": {
      "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk",
      "drizzle-orm": "0.45.3",
      "csv-parse": "7.0.3"
    },
    "get-uri": {
      "basic-ftp": "6.2.2"
    }
  }
}
