{
  "name": "rocky",
  "version": "0.0.0",
  "private": true,
  "description": "Single-user local AI engineering partner",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:i18n": "node scripts/check-i18n.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:i18n && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
